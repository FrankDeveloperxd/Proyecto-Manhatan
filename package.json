{
  "name": "sst-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "firebase": "^12.4.0",
    "leaflet": "^1.9.4",
    "mqtt": "^5.14.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "tailwindcss": "^4.1.15",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.frank.sstguard",
    "productName": "SST Guard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.mjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "artifactName": "SSTGuardInstaller-${version}.exe"
    },
    "nsis": {
      "shortcutName": "SST Guard",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
